# Backend API base URL (no trailing slash). Defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Unsplash API — destination cover photos
# Get a free key at https://unsplash.com/developers (free tier: 50 req/hour)
# Optional: app works without it, cards fall back to gradient placeholders
VITE_UNSPLASH_ACCESS_KEY=
