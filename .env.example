# Root .env — read by docker compose for variable substitution in
# docker-compose.yml. Copy to .env and fill in.

# Backend API URL baked into the frontend bundle at build time
VITE_API_URL=http://localhost:8000

# Optional: Unsplash key for destination cover photos
# https://unsplash.com/developers — free tier 50 req/hour
VITE_UNSPLASH_ACCESS_KEY=

# Backend CORS whitelist (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Ollama for the chat assistant; default points to host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b
